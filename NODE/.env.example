DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecomotor
DB_PORT=3306

# Microsoft Foundry Agents
# Project endpoint format:
# https://<resource>.services.ai.azure.com/api/projects/<project-name>
# If you use only https://<resource>.services.ai.azure.com, also set AZURE_PROJECT_NAME.
AZURE_AGENT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_PROJECT_NAME=<project-name>
AZURE_AGENT_ID=asst_<your-agent-id>
AZURE_AGENT_API_VERSION=2025-05-01

# REST auth documented by Microsoft uses a bearer token from:
# az account get-access-token --resource https://ai.azure.com
AZURE_AGENT_TOKEN=<your-agent-token>

# Keep only if your Foundry resource explicitly supports key auth for your endpoint.
AZURE_API_KEY=
